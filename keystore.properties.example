# Vorlage: diese Datei kopieren, in "keystore.properties" umbenennen und ausfüllen.
# keystore.properties liegt nur lokal und ist in .gitignore – NIEMALS auf GitHub hochladen.
# storeFile ist relativ zum Projektordner (oder ein absoluter Pfad).
storeFile=schnapsen-upload.jks
storePassword=DEIN_KEYSTORE_PASSWORT
keyAlias=upload
keyPassword=DEIN_SCHLUESSEL_PASSWORT
